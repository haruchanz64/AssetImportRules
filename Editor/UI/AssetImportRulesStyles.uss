.air-root {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    background-color: var(--unity-colors-window-background);
    color: var(--unity-colors-window-text);
}

.air-header {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    background-color: var(--unity-colors-app_toolbar-background);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-window-border);
}

.air-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--unity-colors-window-text);
    white-space: normal;
    flex-shrink: 1;
    margin-right: 8px;
}

.air-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    padding: 6px 12px 2px 12px;
    background-color: var(--unity-colors-box-background);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.air-tab-btn {
    margin-right: 6px;
    margin-bottom: 4px;
    height: 26px;
    border-radius: 4px;
    flex-shrink: 0;
}

.air-tab-btn--active {
    background-color: var(--unity-colors-highlight-background);
    border-color: var(--unity-colors-highlight-background);
    color: #ffffff;
    -unity-font-style: bold;
}

.air-body {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    padding: 10px 14px;
}

.air-card {
    background-color: var(--unity-colors-helpbox-background);
    border-width: 1px;
    border-color: var(--unity-colors-helpbox-border);
    border-radius: 6px;
    padding: 10px;
    margin-bottom: 10px;
    min-width: 0;
}

.air-section-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--unity-colors-window-text);
    white-space: normal;
    margin-bottom: 6px;
}

.air-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    min-width: 0;
    margin-bottom: 6px;
}

.air-row > Button {
    margin-right: 4px;
    margin-bottom: 4px;
}

.air-kpi-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 6px;
}

.air-kpi {
    min-width: 110px;
    flex-basis: 120px;
    flex-grow: 1;
    padding: 6px 9px;
    margin-right: 6px;
    margin-bottom: 6px;
    border-radius: 5px;
    background-color: var(--unity-colors-box-background);
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
}

.air-kpi-label {
    font-size: 10px;
    color: var(--unity-colors-default-text);
    opacity: 0.72;
    white-space: normal;
}

.air-kpi-value {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--unity-colors-window-text);
    margin-top: 2px;
}

.air-diff-item {
    background-color: var(--unity-colors-box-background);
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    border-left-width: 3px;
    border-left-color: var(--unity-colors-warning-text);
    border-radius: 4px;
    padding: 6px 8px;
    margin-bottom: 6px;
    min-width: 0;
}

.air-mono {
    font-size: 11px;
    color: var(--unity-colors-default-text);
    white-space: normal;
    flex-shrink: 1;
}

.air-muted {
    font-size: 11px;
    color: var(--unity-colors-default-text);
    opacity: 0.72;
    white-space: normal;
    flex-shrink: 1;
}

.air-status {
    min-height: 24px;
    flex-shrink: 0;
    padding: 4px 12px;
    font-size: 11px;
    white-space: normal;
    background-color: var(--unity-colors-app_toolbar-background);
    border-top-width: 1px;
    border-top-color: var(--unity-colors-window-border);
    color: var(--unity-colors-default-text);
}
